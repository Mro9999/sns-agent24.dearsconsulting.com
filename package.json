        "@sendgrid/mail": "^8.1.6",
        "@stripe/stripe-js": "^4.0.0",
        "@supabase/supabase-js": "^2.99.1",
        "@vercel/functions": "^3.6.1",
        "@vercel/og": "^0.11.1",
        "call-bound": "^1.0.4",
        "dotenv": "^17.4.0",
        "get-intrinsic": "^1.3.0",
        "lucide-react": "^1.24.0",
        "next": "^16.2.11",
        "posthog-js": "^1.363.4",
        "qs": "^6.15.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sharp": "0.35.3",
        "side-channel": "^1.1.0",
        "side-channel-map": "^1.0.1",
        "stripe": "^15.12.0",
        "svix": "^1.86.0",
        "twitter-api-v2": "^1.29.0"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.27",
