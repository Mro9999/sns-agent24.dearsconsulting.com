{
    "name": "instagram-auto",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "test:copy-safety": "node --test src/lib/copySafety.test.mjs",
        "test:billing": "node --test src/lib/subscriptionAccess.test.mjs src/lib/checkoutPlan.test.mjs src/lib/promaxBillingPortal.test.mjs",
        "test:account-status": "node --test src/lib/accountPlan.test.mjs",
        "test:links": "node --test src/lib/linkSafety.test.mjs",
        "test:ui-safety": "node --test src/lib/uiSafety.test.mjs",
        "test:generation-quota": "node --test src/lib/generationQuota.test.mjs",
        "test:image-generation": "node --test src/lib/geminiImage.test.mjs",
        "test:vercel-trace": "node scripts/verify-vercel-trace.mjs",
        "billing:inspect": "node --env-file=.env.local scripts/configure-promax-billing-portal.mjs",
        "billing:configure-portal": "node --env-file=.env.local scripts/configure-promax-billing-portal.mjs --apply"
    },
    "dependencies": {
        "@clerk/localizations": "^4.13.4",
        "@clerk/nextjs": "^7.5.19",
